{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "node -e \"console.log('[build] tsc — 1536MB heap (safe on t3.small 2 GiB; use build:large on laptop/CI).');\" && node --max-old-space-size=1536 ./node_modules/typescript/lib/tsc.js --pretty false",
    "build:large": "node -e \"console.log('[build:large] tsc — 2048MB heap.');\" && node --max-old-space-size=2048 ./node_modules/typescript/lib/tsc.js --pretty false",
    "build:micro": "node -e \"console.log('[build:micro] tsc — 768MB heap for t3.micro 1 GiB only.');\" && node --max-old-space-size=768 ./node_modules/typescript/lib/tsc.js --pretty false",
    "build:ec2": "npm run build",
    "build:profile": "node --max-old-space-size=2048 ./node_modules/typescript/lib/tsc.js --pretty false --diagnostics --extendedDiagnostics",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "3.948.0",
    "@types/multer": "2.0.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.81.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "4.22.0",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^12.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.0.2",
    "mysql2": "3.15.3",
    "razorpay": "^2.9.2",
    "redis": "5.11.0",
    "reflect-metadata": "0.2.2",
    "twilio": "5.12.2",
    "typeorm": "0.3.27"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "nodemon": "^3.0.1",
    "prettier": "3.7.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
